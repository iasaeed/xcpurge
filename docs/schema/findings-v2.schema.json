{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iasaeed/xcpurge/docs/schema/findings-v2.schema.json",
  "title": "xcpurge scan report",
  "description": "The document `xcpurge scan|assets|strings|files --format json` writes (schemaVersion 2). Optional fields and enum values may be added without a version bump, so objects are open and consumers must ignore unknown keys and values; see docs/schema/README.md.",
  "type": "object",
  "required": ["schemaVersion", "tool", "root", "modules", "summary", "size", "findings", "diagnostics"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "const": "xcpurge" },
        "version": { "type": "string", "description": "Semantic version of the xcpurge that wrote the file." }
      }
    },
    "root": { "type": "string", "description": "Absolute, symlink-resolved scan root. Every other path is relative to it." },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/ModuleEntry" } },
    "summary": {
      "type": "object",
      "required": ["byKind", "count", "bytes"],
      "properties": {
        "byKind": {
          "type": "object",
          "description": "Finding count per kind (camelCase kind names); kinds with no finding are absent.",
          "propertyNames": { "$ref": "#/$defs/FindingKind" },
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "count": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0, "description": "Sum of sizeBytes over all findings." }
      }
    },
    "size": { "$ref": "#/$defs/SizeReport" },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" }, "description": "Sorted by category, kind, path, name, line." },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/Diagnostic" } },
    "baseline": { "$ref": "#/$defs/BaselineReport", "description": "Present only when --baseline was applied." }
  },
  "$defs": {
    "FindingKind": {
      "type": "string",
      "enum": ["unusedAsset", "unusedFont", "unusedString", "staleString", "orphanFile", "ghostReference", "deadSource",
               "unusedInterfaceFile", "unusedResource", "duplicate", "dynamicLookup", "staleIgnore"]
    },
    "Category": { "type": "string", "enum": ["assets", "strings", "files", "duplicates", "ignores"] },
    "Confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "ModuleKind": {
      "type": "string",
      "enum": ["app", "appExtension", "appClip", "watchApp", "framework", "staticLib", "packageLibrary", "packageExecutable",
               "unitTest", "uiTest", "macro", "plugin", "aggregate", "unknown"]
    },
    "ModuleID": {
      "type": "object",
      "required": ["container", "name"],
      "properties": {
        "container": { "type": "string", "description": "Root-relative .xcodeproj or package directory; empty for files no project claims." },
        "name": { "type": "string", "description": "Target name." }
      }
    },
    "ModuleEntry": {
      "type": "object",
      "required": ["id", "kind", "dependsOn", "embeds"],
      "properties": {
        "id": { "$ref": "#/$defs/ModuleID" },
        "kind": { "$ref": "#/$defs/ModuleKind" },
        "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/ModuleID" } },
        "embeds": { "type": "array", "items": { "$ref": "#/$defs/ModuleID" } }
      }
    },
    "Finding": {
      "type": "object",
      "required": ["id", "kind", "category", "path", "module", "confidence", "reasons"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+(-[a-z]+)*-[0-9a-f]{10}$",
          "description": "Stable id: the kind in kebab-case plus 10 hex digits of FNV-1a-64 over the identity key and path (unused-asset-8324ee39c9). Repeats only for identical dynamic lookups in one file."
        },
        "kind": { "$ref": "#/$defs/FindingKind" },
        "category": { "$ref": "#/$defs/Category" },
        "path": { "type": "string", "description": "Root-relative path of the file or bundle unit (an .imageset folder, a .lproj)." },
        "line": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "description": "Asset name, string key, declaration or rule text, when the finding is about a named thing." },
        "module": { "type": "string", "description": "Display name of the owning module, or `unknown`." },
        "confidence": { "$ref": "#/$defs/Confidence" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "groupID": { "type": "string", "description": "Shared by the copies of one duplicate group." },
        "history": { "$ref": "#/$defs/FindingHistory" }
      }
    },
    "FindingHistory": {
      "type": "object",
      "description": "Git history of the finding's path (--git). Never changes confidence or reasons.",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["ok", "shallow", "untracked", "not-git", "unavailable"] },
        "lastCommit": { "$ref": "#/$defs/Commit" },
        "ageDays": { "type": "integer", "minimum": 0 },
        "bucket": { "type": "string", "enum": ["recentlyAdded", "leftover"] },
        "deadSince": { "$ref": "#/$defs/Commit", "description": "Heuristic: the commit that removed the last use (--git-dead-since)." },
        "note": { "type": "string" }
      }
    },
    "Commit": {
      "type": "object",
      "required": ["sha", "date", "authorName", "subject"],
      "properties": {
        "sha": { "type": "string" },
        "date": { "type": "string", "description": "ISO 8601 author date." },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string", "description": "Only with --git-emails." },
        "subject": { "type": "string" }
      }
    },
    "BaselineEntry": {
      "type": "object",
      "required": ["key", "kind", "category", "module", "path", "count"],
      "properties": {
        "key": { "type": "string", "description": "Identity key (`kind|module|name`, …); see FindingIdentity." },
        "kind": { "$ref": "#/$defs/FindingKind" },
        "category": { "$ref": "#/$defs/Category" },
        "module": { "type": "string" },
        "path": { "type": "string" },
        "name": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "BaselineReport": {
      "type": "object",
      "required": ["file", "createdAt", "ageDays", "toolVersion", "baselinedCount", "newCount", "fixed", "warnings", "strict"],
      "properties": {
        "file": { "type": "string" },
        "createdAt": { "type": "string", "description": "ISO 8601." },
        "ageDays": { "type": "integer", "minimum": 0 },
        "toolVersion": { "type": "string" },
        "baselinedCount": { "type": "integer", "minimum": 0, "description": "Findings the baseline hid." },
        "newCount": { "type": "integer", "minimum": 0, "description": "Findings not in the baseline (the ones listed)." },
        "fixed": { "type": "array", "items": { "$ref": "#/$defs/BaselineEntry" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "strict": { "type": "boolean" }
      }
    },
    "Diagnostic": {
      "type": "object",
      "required": ["level", "message"],
      "properties": {
        "level": { "type": "string", "enum": ["info", "warning", "error"] },
        "message": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "SizeEntry": {
      "type": "object",
      "required": ["name", "files", "bytes"],
      "properties": {
        "name": { "type": "string" },
        "files": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "ModuleSize": {
      "type": "object",
      "required": ["id", "files", "bytes"],
      "properties": {
        "id": { "type": "string", "description": "`container:name`, or `(unattributed)`." },
        "files": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "TreeSize": {
      "type": "object",
      "required": ["total", "files", "categories", "modules"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "files": { "type": "integer", "minimum": 0 },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/SizeEntry" } },
        "modules": { "type": "array", "items": { "$ref": "#/$defs/ModuleSize" } },
        "assetCatalogs": { "type": "array", "items": { "$ref": "#/$defs/SizeEntry" }, "description": "Only from `xcpurge size`." },
        "assetTypes": { "type": "array", "items": { "$ref": "#/$defs/SizeEntry" }, "description": "Only from `xcpurge size`." }
      }
    },
    "Reclaimable": {
      "type": "object",
      "required": ["high", "highMedium"],
      "properties": {
        "high": { "type": "integer", "minimum": 0 },
        "highMedium": { "type": "integer", "minimum": 0 },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/Category" } }
      }
    },
    "SizeReport": {
      "type": "object",
      "required": ["tree", "reclaimable"],
      "properties": {
        "tree": { "$ref": "#/$defs/TreeSize" },
        "reclaimable": { "$ref": "#/$defs/Reclaimable" }
      }
    }
  }
}
